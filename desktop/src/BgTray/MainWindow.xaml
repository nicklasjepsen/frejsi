<Window x:Class="BgTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frejsi"
        Width="196" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh now" Click="Refresh_Click" />
            <MenuItem Header="Settings…" Click="Settings_Click" />
            <Separator />
            <MenuItem Header="Hide (the tray icon stays)" Click="Hide_Click" />
        </ContextMenu>
    </Window.ContextMenu>
    <Border x:Name="Card" Margin="8"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
            CornerRadius="14" Padding="16,12,16,12"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Value row: a colour bar, the big number, the arrow and the change. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="RangeBar" Width="5" CornerRadius="3" Margin="0,6,12,6" Background="{DynamicResource Accent}" />
                <TextBlock x:Name="ValueText" Grid.Column="1" Text="--"
                           FontSize="44" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" Margin="0,-4,0,0" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock x:Name="ArrowText" Text="" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" LineHeight="28" />
                    <TextBlock x:Name="DeltaText" Text="" FontSize="13"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
            </Grid>

            <!-- Age row: always shown with a value. -->
            <TextBlock x:Name="AgeText" Grid.Row="1" Text="" FontSize="13" Margin="17,2,0,0"
                       Foreground="{DynamicResource TextSecondary}" />

            <!-- Problem row: the plain-words reason the number may be old. -->
            <TextBlock x:Name="ProblemText" Grid.Row="2" Text="" FontSize="12" Margin="17,6,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextSecondary}" />
        </Grid>
    </Border>
</Window>
