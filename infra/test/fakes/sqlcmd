#!/usr/bin/env bash
# Fake sqlcmd: records the arguments and the SQL it was given.
set -euo pipefail
printf 'sqlcmd %s\n' "$*" >> "$FAKE_LOG"
n=$(cat "$FAKE_LOG_DIR/sqlcmd-count" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$FAKE_LOG_DIR/sqlcmd-count"
prev=""
for a in "$@"; do
  if [ "$prev" = "-i" ]; then
    cp "$a" "$FAKE_LOG_DIR/sqlcmd-$n.sql"
    stat -c '%a' "$a" > "$FAKE_LOG_DIR/sqlcmd-$n.mode"
    printf '%s\n' "$a" > "$FAKE_LOG_DIR/sqlcmd-$n.path"
  fi
  prev="$a"
done
