{
  "name": "frejsi",
  "version": "0.0.0",
  "private": true,
  "description": "Carb lookup and live glucose for one person with diabetes and the people around them",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm test:scripts && pnpm -r test",
    "test:scripts": "vitest run --project scripts",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath scripts/git-hooks"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": ">=8.5.23",
      "deepmerge-ts": ">=8.0.0",
      "mssql": ">=12.7.9",
      "tedious": ">=20.3.7"
    }
  }
}
