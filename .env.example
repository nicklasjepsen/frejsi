# Copy to .env for local development. Placeholders only: never commit a real value.
# Production values come from Key Vault through infra/deploy.sh and Bicep outputs
# (docs/superpowers/plans/2026-10-14-v0.1.0-foundation.md §7).

# Azure SQL (local: a SQL Server container). Also needed by `pnpm --filter ./shared prisma:check`.
DATABASE_URL="sqlserver://localhost:1433;database=frejsi;user=sa;password=<local-sa-password>;encrypt=true;trustServerCertificate=true"

# Web
APP_ORIGIN="http://localhost:3000"
BOOTSTRAP_TOKEN="<random-token-for-the-first-space>"
WEB_PUBSUB_CONNECTION_STRING="<from-a-dev-web-pubsub-or-empty-to-poll>"
WEB_PUBSUB_HUB="frejsi"
SOURCE_CONNECT_URL="http://localhost:7071/api/source-connect"
SOURCE_CONNECT_KEY="<function-key-or-empty-locally>"
NEXT_PUBLIC_APP_VERSION="dev"

# Poller
WEB_PUBSUB_ENDPOINT="<https://your-web-pubsub.webpubsub.azure.com>"
KEY_VAULT_URL="<https://your-key-vault.vault.azure.net>"
APP_VERSION="dev"

# Both
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Dev and e2e only: 1 makes the poller, the seed and the e2e use FakeGlucoseSource.
FAKE_GLUCOSE_SOURCE="1"
