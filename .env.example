# Copy to .env for local development. Placeholders only: never commit a real value.
# Production values come from Key Vault through infra/deploy.sh and Bicep outputs
# (docs/superpowers/plans/2026-10-14-v0.1.0-foundation.md §7).

# Azure SQL (local: a SQL Server container). Also needed by `pnpm --filter ./shared prisma:check`.
DATABASE_URL="sqlserver://localhost:1433;database=frejsi;user=sa;password=<local-sa-password>;encrypt=true;trustServerCertificate=true"

# Poller in Azure: connects to SQL as its managed identity instead of DATABASE_URL (placeholders;
# infra/README.md). With DATABASE_URL set these are ignored.
SQL_SERVER_FQDN="<your-sql-server.database.windows.net>"
SQL_DATABASE="frejsi"
AZURE_CLIENT_ID="<client-id-of-the-poller-identity>"

# The first language a visitor sees with no cookie and no Accept-Language: da or en. Unset means da.
DEFAULT_LOCALE="da"

# Web
APP_ORIGIN="http://localhost:3000"
BOOTSTRAP_TOKEN="<random-token-for-the-first-space>"
WEB_PUBSUB_CONNECTION_STRING="<from-a-dev-web-pubsub-or-empty-to-poll>"
WEB_PUBSUB_HUB="frejsi"
SOURCE_CONNECT_URL="http://localhost:7071/api/source-connect"
SOURCE_CONNECT_KEY="<function-key-or-empty-locally>"
NEXT_PUBLIC_APP_VERSION="dev"

# Poller
WEB_PUBSUB_ENDPOINT="<https://your-web-pubsub.webpubsub.azure.com>"
KEY_VAULT_URL="<https://your-key-vault.vault.azure.net>"
APP_VERSION="dev"

# Both
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Dev and e2e only: 1 makes the poller, the seed and the e2e use FakeGlucoseSource.
FAKE_GLUCOSE_SOURCE="1"

# AI: per-space local-day attempt limits; no production provider is enabled by default.
AI_DAILY_CAP=50
AI_EMBED_DAILY_CAP=500
AI_EMBED_BACKFILL_DAILY_CAP=2000
# Shared-cache embedding provider id, configured only when its adapter and keys are available.
AI_CACHE_EMBED_PROVIDER=
# Dev and e2e only: 1 selects offline fictional responses for every AI provider id.
FAKE_AI_PROVIDER=

# Optional: send a carer's correction of an Open Food Facts product back to OFF (never automatic).
# Without an account the checkbox is absent. OFF_CONTRIBUTE_HOST defaults to the production host;
# use world.openfoodfacts.net with a staging account for a first try.
OFF_CONTRIBUTE_USER=""
OFF_CONTRIBUTE_PASSWORD=""
OFF_CONTRIBUTE_HOST=""
# Dev and e2e only: 1 makes the contributions service use FakeFoodContributor (no network).
FAKE_FOOD_CONTRIBUTOR=""

# Optional AI adapters. Empty values leave providers inactive; keys are deploy-wide, AI is opt-in per space.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Azure can use managed identity when its key is absent. Everyday deployment is required.
AZURE_OPENAI_DEPLOYMENT_SMALL=
AZURE_OPENAI_DEPLOYMENT_EVERYDAY=
AZURE_OPENAI_DEPLOYMENT_INSIGHT=
AZURE_OPENAI_DEPLOYMENT_EMBED=
# Ollama URL and an everyday model are required. Small/insight default to the everyday model.
OLLAMA_URL=
OLLAMA_MODEL_SMALL=
OLLAMA_MODEL_EVERYDAY=
OLLAMA_MODEL_INSIGHT=
OLLAMA_MODEL_EMBED=
