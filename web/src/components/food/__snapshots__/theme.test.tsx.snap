// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`food kit theme matrix > forest dark: checked badge, pressed chip and selected tile 1`] = `
{
  "html": "<div data-accent="forest" data-mode="dark"><span class="_theme_030889 _badge_030889" data-variant="checked">Tjekket</span><button type="button" class="_theme_030889 _chip_030889 " aria-pressed="true" data-variant="default">Fictional food</button><button type="button" class="_theme_030889 _tile_b361ff" data-size="104" aria-pressed="true"><div class="_tileImage_b361ff" style="height:104px"><span class="_placeholder_b361ff" role="img" aria-label="foto">foto</span><span data-testid="selection-check" class="_selectionCheck_b361ff" aria-hidden="true">✓</span></div><span class="_tileTitle_b361ff">Fictional food</span></button></div>",
  "palette": "
    --accent-base: #86bbad;
    --accent-strong: #a3d0c4;
    --accent-tint: #27403a;
    --accent-tint-border: #3a5c53;
    --accent-band: #86bbad;
    --accent-on: #1f1b17;
  ",
  "tintRules": ".theme {
  --kit-tint: var(--accent-tint);
  --kit-tint-border: var(--accent-tint-border);
}
:global([data-accent="sea"]) .theme,
:global([data-accent="forest"]) .theme,
:global([data-accent="garnet"]) .theme {
  --kit-tint: color-mix(in srgb, var(--accent-base) 12%, var(--surface));
  --kit-tint-border: color-mix(in srgb, var(--accent-base) 30%, var(--surface));
}
",
}
`;

