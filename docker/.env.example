# Docker Compose settings. Placeholders only: `docker/init-secrets.sh` copies this file to
# docker/.env (git and Docker both ignore it) and fills every <generated-by-init-secrets> with a
# value it generates. Never commit docker/.env.

# SQL Server's `sa` password, used by the sql container and in DATABASE_URL.
SQL_SA_PASSWORD="<generated-by-init-secrets>"
DATABASE_URL="sqlserver://sql:1433;database=frejsi;user=sa;password=<generated-by-init-secrets>;encrypt=true;trustServerCertificate=true"

# Azurite, with one account of its own named frejsi and a key init-secrets.sh generates: the
# emulator's well-known key is not used. The browser reads photos from BLOB_PUBLIC_ENDPOINT (the
# published port); the containers reach Azurite as `azurite`.
AZURITE_ACCOUNT_KEY="<generated-by-init-secrets>"
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=frejsi;AccountKey=<generated-by-init-secrets>;BlobEndpoint=http://azurite:10000/frejsi"
BLOB_PUBLIC_ENDPOINT="http://localhost:10000/frejsi"

# One file per secret (a glucose source's credential), in the poller's `credentials` volume.
SECRETS_DIR="/credentials"

# The first space is created with this token (docs/deploy-your-own.md, "Docker Compose").
BOOTSTRAP_TOKEN="<generated-by-init-secrets>"

# The web app saves a glucose source's credential through the poller; the key is the poller's
# function key, written to the host-keys volume as source-connect.json.
SOURCE_CONNECT_URL="http://poller/api/source-connect"
SOURCE_CONNECT_KEY="<generated-by-init-secrets>"

# Passkeys are bound to this origin. http://localhost:3000 works on one machine; behind a TLS proxy
# set the real https hostname before the first bootstrap.
APP_ORIGIN="http://localhost:3000"

# The first language a visitor sees (da or en), the food plugins, and the country Open Food Facts
# prefers (a two-letter code; empty means the whole world).
DEFAULT_LOCALE="da"
FOOD_SOURCES="off,frida"
OFF_COUNTRY=""

# 1 gives every space fictional readings (to try Frejsi without a sensor); empty uses the real
# source each space is connected to.
FAKE_GLUCOSE_SOURCE=""
