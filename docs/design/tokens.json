      "primaryPhoneSmall": { "size": 17, "weight": 700 },
      "primaryDesktop": { "size": 15, "weight": 700 },
      "primaryDesktopLarge": { "size": 16, "weight": 700 },
      "secondary": { "size": 14 },
      "chip": { "size": 14 },
      "chipSmall": { "size": 13 },
      "portionChip": { "size": 15 },
      "simplePrimary": { "size": 26, "weight": 700 },
      "simplePrimaryDesktop": { "size": 28, "weight": 700 },
      "simpleSecondary": { "size": 21, "weight": 700 },
      "simpleSecondaryDesktop": { "size": 22, "weight": 700 },
      "simpleConfirm": { "size": 24, "weight": 700 },
      "navLabelPhone": { "size": 12, "activeWeight": 700 },
      "navLabelPhoneSimple": { "size": 15, "weight": 700 },
      "navItemDesktop": { "size": 15, "activeWeight": 700 },
      "navItemDesktopSimple": { "size": 20, "weight": 700 },
      "shortcutHint": { "size": 12, "color": "textMuted" },
      "kbd": { "size": 12, "color": "textMuted", "border": "1px solid hairline", "radius": 6, "padding": "2px 6px" },
      "badge": { "size": 12, "weight": 700, "paddingPhone": "2px 8px", "paddingDesktop": "3px 8px", "radius": 999 },
      "viewerPill": { "size": 13, "padding": "4px 10px", "border": "1px solid hairline", "radius": 999, "_text": "Du ser med" },
      "sectionNavItem": { "size": 15, "padding": "10px 12px", "radius": 10, "active": "surface + cardShadow + 700", "columnWidth": "180–220", "_source": "Indstillinger-Desktop" }
    }
