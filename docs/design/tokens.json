{
  "$schema": "https://json.schemastore.org/base.json",
  "name": "Frejsi design tokens",
  "source": "docs/design/artboards/*.dc.html (Claude Design hand-in, direction A \"Kitchen table\", 2026-10-14)",
  "note": "Every value below is read from the artboards. Where a value exists only in one artboard it is marked. Where the artboards show nothing, the key is absent and the gap is listed in docs/design/README.md under Design gaps.",

  "color": {
    "light": {
      "ground": "#F6F1E8",
      "surface": "#FFFCF6",
      "surfaceSunken": "#EEE7DA",
      "surfaceSelected": "#F3EEE3",
      "surfaceInput": "#FFFFFF",
      "text": "#2B2622",
      "textMuted": "#6E6458",
      "hairline": "#E7DFD0",
      "hairlineStrong": "#C9BFA9",
      "gridline": "#B9AE98",
      "cardShadow": "0 1px 0 #E7DFD0",
      "avatar": {
        "subject": { "bg": "#D9CDB8", "fg": "#5A4E3C" },
        "member": { "bg": "#E4D8C3", "fg": "#5A4E3C" },
        "owner": { "bg": "#CFD8B8", "fg": "#3F4C28" },
        "pending": { "border": "2px dashed #C9BFA9", "fg": "#6E6458" }
      },
      "photoPlaceholder": { "bg": "#E4D8C3", "fg": "#7A6B52" },
      "curve": { "line": "#2B2622", "previous": "#2B2622", "previousOpacity": 0.18, "previousOpacityDesktop": 0.16 },
      "meal": { "marker": "#C4674A", "bolusMarker": "#A3503A" },
      "unverified": { "bg": "#F6E3DB", "fg": "#A3503A", "border": "#A3503A" },
      "destructive": "#A3503A",
      "switchOff": "#C9BFA9",
      "accent": {
        "olive": { "da": "Oliven", "default": true, "base": "#5A6A3B", "strong": "#3F4C28", "tint": "#E9ECDF", "tintBorder": "#C9CDB8", "band": "#6B7A4B", "bandOpacity": 0.12, "onAccent": "#F6F1E8" },
        "plum": { "da": "Blomme", "base": "#5B3F73", "strong": "#432C57", "tint": "#EAE3EF", "band": "#5B3F73", "bandOpacity": 0.12, "onAccent": "#F6F1E8" },
        "sea": { "da": "Hav", "base": "#3B5F7E", "strong": "#2B4660", "band": "#3B5F7E", "bandOpacity": 0.12, "onAccent": "#F6F1E8" },
        "forest": { "da": "Skov", "base": "#2F6B5E", "strong": "#22514A", "band": "#2F6B5E", "bandOpacity": 0.12, "onAccent": "#F6F1E8" },
        "garnet": { "da": "Granat", "base": "#7A3A4B", "strong": "#5C2A38", "band": "#7A3A4B", "bandOpacity": 0.12, "onAccent": "#F6F1E8" }
      }
    },
    "dark": {
      "_source": "Nu-Moerk.dc.html only (olive accent). Other accents and other screens have no dark artboard.",
      "ground": "#1F1B17",
      "surface": "#2A2521",
      "text": "#F1EADF",
      "textMuted": "#B5AA9A",
      "hairline": "#3A332C",
      "gridline": "#6E6458",
      "cardBorder": "1px solid #3A332C",
      "avatar": { "subject": { "bg": "#4A3F33", "fg": "#E7DBC6" } },
      "photoPlaceholder": { "bg": "#4A3F33", "fg": "#C9BBA3" },
      "curve": { "line": "#F1EADF" },
      "meal": { "marker": "#E08A6C" },
      "accent": {
        "olive": { "da": "Oliven", "default": true, "base": "#9DAE78", "strong": "#B8C797", "band": "#9DAE78", "bandOpacity": 0.14, "onAccent": "#1F1B17" }
      }
    },
    "rules": {
      "glucoseNumber": "Always the text colour (light #2B2622, dark #F1EADF). Never coloured by value: 'tallet er altid sort – uanset farve' (Farve-Indstilling). No red for highs or lows.",
      "mealMarker": "Always terracotta (#C4674A light, #E08A6C dark) regardless of accent: 'Måltider er altid teglrøde' (Farve-Indstilling).",
      "accentIdentifiers": "Code uses the English keys (olive, plum, sea, forest, garnet); the Danish names are UI strings in da.json.",
      "accent": "Per person, chosen under Mere → Farve. Changes buttons, active nav, status dot, trend arrow, selected chips and the range band only."
    }
  },

  "font": {
    "display": { "family": "Newsreader", "fallback": "Georgia, serif", "weights": [600], "weightsLoaded": [500, 600], "weightsNote": "the Google Fonts href loads 500 and 600; no artboard uses 500", "opticalSize": "6..72", "use": "headings, dish and person names, the Frejsi wordmark" },
    "body": { "family": "Atkinson Hyperlegible", "fallback": "system-ui, sans-serif", "weights": [400, 700], "use": "everything else, including the glucose number (700, tabular-nums)" },
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Atkinson+Hyperlegible:wght@400;700&display=swap",
    "numerals": "font-variant-numeric: tabular-nums on every number that can change (glucose, grams, times, tables)"
  },

  "type": {
    "_unit": "px; lineHeight unitless; letterSpacing em",
    "glucoseHero": {
      "phone": { "size": 100, "lineHeight": 0.95, "weight": 700, "letterSpacing": -0.04 },
      "phoneSimple": { "size": 148, "lineHeight": 0.95, "weight": 700, "letterSpacing": -0.05 },
      "desktop": { "size": 92, "lineHeight": 0.95, "weight": 700, "letterSpacing": -0.04 },
      "desktopSimple": { "size": 200, "lineHeight": 0.9, "weight": 700, "letterSpacing": -0.05 },
      "settingsPreview": { "size": 56, "lineHeight": 0.95, "weight": 700, "letterSpacing": -0.04 },
      "viewerCarbTotal": { "size": 72, "lineHeight": 1, "weight": 700, "letterSpacing": -0.04 },
      "inlineInHeader": { "size": 22, "weight": 700, "_source": "Log-Desktop header" }
    },
    "glucoseMeta": { "phone": 17, "phoneSimple": 22, "desktop": 16, "desktopSimple": 26, "_text": "mmol/L · for 3 min. siden · stiger langsomt" },
    "display": {
