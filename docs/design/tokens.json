      "invitePhone": { "size": 34, "lineHeight": 1.1, "weight": 600 },
      "h1Desktop": { "size": 30, "weight": 600, "letterSpacing": -0.01 },
      "h1PhoneSimple": { "size": 30, "weight": 600 },
      "greetingSimple": { "size": 28, "weight": 600 },
      "h1Phone": { "size": 26, "weight": 600 },
      "wordmarkSidebar": { "size": 26, "weight": 600, "letterSpacing": -0.01 },
      "h1PhoneWithBack": { "size": 24, "weight": 600 },
      "sectionTitle": { "size": 22, "weight": 600 },
      "subjectName": { "size": 22, "weight": 600 },
      "wordmarkInvite": { "size": 22, "weight": 600, "color": "textMuted" },
      "wordmarkInviteDesktop": { "size": 24, "weight": 600, "color": "textMuted" },
      "tileTitleSimpleLarge": { "size": 26, "lineHeight": 1.1, "weight": 600 },
      "tileTitleSimple": { "size": 21, "lineHeight": 1.1, "weight": 600 },
      "tileTitleSimpleDesktop": { "size": 22, "weight": 600 },
      "mealTitleSimple": { "size": 21, "lineHeight": 1.15, "weight": 600 },
      "mealTitleSimpleDesktop": { "size": 24, "lineHeight": 1.15, "weight": 600 },
      "cardTitleLarge": { "size": 19, "lineHeight": 1.2, "weight": 600 },
      "cardTitle": { "size": 18, "lineHeight": 1.15, "weight": 600 },
      "cardTitleSmall": { "size": 17, "lineHeight": 1.15, "weight": 600 },
      "tableName": { "size": 17, "weight": 600 }
    },
    "body": {
      "simpleLead": { "size": 20, "color": "textMuted" },
      "simpleLeadDesktop": { "size": 24, "color": "textMuted" },
      "simpleLeadBody": { "size": 17, "lineHeight": 1.4, "color": "textMuted", "_source": "Maaltid-Simpel" },
      "simpleLabel": { "size": 16 },
      "inviteLead": { "size": 17, "lineHeight": 1.45 },
      "inviteLeadDesktop": { "size": 18, "lineHeight": 1.5 },
      "listTitle": { "size": 16, "weight": 700 },
      "body": { "size": 15, "lineHeight": 1.45 },
      "bodySmall": { "size": 14 },
      "secondary": { "size": 13, "color": "textMuted", "lineHeight": 1.45 },
      "caption": { "size": 12, "color": "textMuted", "lineHeight": 1.45 },
      "chartAxis": { "size": 11, "color": "textMuted" },
      "chartAxisDesktop": { "size": 12, "color": "textMuted" }
