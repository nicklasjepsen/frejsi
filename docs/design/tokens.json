  "chart": {
    "sparklinePhone": { "viewBox": "0 0 326 120", "plotWidth": 296, "height": 120 },
    "curvePhone": { "viewBox": "0 0 326 118", "plotWidth": 296, "height": 118 },
    "curveDesktopDay": { "viewBox": "0 0 720 220", "plotWidth": 680, "height": 230 },
    "curveDesktopMeal": { "viewBox": "0 0 760 262", "plotWidth": 720, "height": 270 },
    "weekTile": { "viewBox": "0 0 120 64", "height": 64 },
    "settingsPreview": { "viewBox": "0 0 302 60", "height": 60 },
    "rangeBand": "rect across the plot between the target bounds, fill = accent.band at bandOpacity; dashed gridlines (stroke-dasharray 3 4, width 1) at both bounds; bound labels right of the plot (11px phone, 12px desktop)",
    "line": { "width": 2.5, "linejoin": "round", "linecap": "round", "endDot": 5 },
    "previousLine": { "width": 1.5, "opacity": 0.18 },
    "weekLine": { "width": 1.8 },
    "mealLine": { "stroke": "meal.marker", "width": 1.5, "vertical": true },
    "bolusTriangle": { "fill": "meal.bolusMarker", "size": 10, "position": "on the baseline at the bolus time" },
    "autoBolusMarker": { "shape": "hollow triangle", "stroke": "text", "strokeOpacity": 0.6, "strokeWidth": 1.2, "fill": "none", "size": 7, "position": "on the baseline at the bolus time; automatic and other pump boluses (v0.7.0), never meal.bolusMarker" },
    "pumpReach": { "stroke": "textMuted", "strokeWidth": 1, "dasharray": "1 3", "caption": "'Pumpe til HH:MM' in textMuted at the axis label size, beside the tick", "when": "the pump record's newest time is inside the window and older than the newest reading (v0.7.0)" },
    "weekMealDot": { "r": 2.5, "fill": "meal.marker" },
