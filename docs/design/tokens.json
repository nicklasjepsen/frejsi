  "icons": { "style": "inline SVG, stroke currentColor, round caps and joins; stroke-width 2–2.4 for nav and sidebar icons, 1.6–1.8 for small inline icons, 2.6–3 for emphasised plus signs, 3.5 for the trend arrow (4 inline on Log-Desktop, 5 in simpleMode); 26px grid in bottom nav, 22px in sidebar, 18–20px inline" }
