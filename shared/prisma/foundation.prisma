// Frozen v0.1.0 datamodel for prisma:check; evolve schema.prisma, not this snapshot.
// The whole schema for v0.1.0 (plan §3). Enums are String columns validated by the Zod enums in
// src/schemas/; JSON is NVarChar(Max) parsed with Zod (the SQL Server connector has no Json).
// One migration, 0001_foundation; no other v0.1.0 task changes this file.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  name       String
  avatar     String?
  simpleMode Boolean   @default(false)
  accent     String    @default("olive")
  locale     String    @default("da")
  createdAt  DateTime  @default(now())
  lastSeen   DateTime?

  memberships    Membership[]
  passkeys       Passkey[]
  sessions       Session[]
  invitesCreated Invite[]     @relation("InviteCreatedBy")
  invitesFor     Invite[]     @relation("InviteForUser")
  subjectOf      Space[]      @relation("SpaceSubject")
}

model Space {
  id             String    @id @default(cuid())
  name           String
  subjectUserId  String?
  timezone       String
  glucoseUnit    String    @default("mmol")
  targetLow      Decimal   @default(4.0) @db.Decimal(4, 1)
  targetHigh     Decimal   @default(10.0) @db.Decimal(4, 1)
  glucoseSource  String?   @db.NVarChar(Max)
  sourceStatus   String    @default("not-configured")
  sourceFailures Int       @default(0)
  lastReadingAt  DateTime?
  lastSeq        Int       @default(0)
  aiEnabled      Boolean   @default(false)
  aiProvider     String?
  createdAt      DateTime  @default(now())

  subjectUser User?        @relation("SpaceSubject", fields: [subjectUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberships Membership[]
  invites     Invite[]
  readings    Reading[]
  events      Event[]
}

model Membership {
  userId    String
  spaceId   String
  role      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@index([spaceId])
}

model Invite {
  token     String    @id
  spaceId   String
  role      String
  name      String
  forUserId String?
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  space   Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User  @relation("InviteCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  forUser User? @relation("InviteForUser", fields: [forUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([spaceId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique @db.NVarChar(512)
  publicKey    Bytes
  counter      Int
  transports   String?
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
}

model Session {
  id         String   @id
  userId     String
  passkeyId  String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkey Passkey? @relation(fields: [passkeyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([passkeyId])
}

model AuthChallenge {
  id          String   @id @default(cuid())
  challenge   String
  kind        String
  inviteToken String?
  userId      String?
  expiresAt   DateTime
}

model Reading {
  spaceId String
  ts      DateTime
  mmol    Decimal @db.Decimal(4, 1)
  trend   String
  source  String

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, ts], clustered: true)
}

model Event {
  spaceId String
  seq     Int
  type    String
  payload String   @db.NVarChar(Max)
  ts      DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, seq])
  @@index([spaceId, ts])
}
