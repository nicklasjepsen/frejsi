engine-strict=true
auto-install-peers=true
strict-peer-dependencies=false
# A flat node_modules, without symlinks. Next's standalone trace copies node_modules as laid out
# here, and the GitHub artifact between release jobs drops symlinks: under pnpm's isolated layout
# the deployed server could not find next's own dependencies ("Cannot find module
# 'styled-jsx/package.json'", the v0.2.x deploys). web/scripts/prepare-standalone.ts fails the
# build if a symlink reaches the bundle again.
node-linker=hoisted
